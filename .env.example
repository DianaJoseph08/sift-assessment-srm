# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored and must never be committed.

# Choose: "ollama" for running a local model, or "claude" for Anthropic (default "claude").
LLM_PROVIDER=claude

# If using "claude", configure your Anthropic API key.
# Create one at https://console.anthropic.com/ -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# If using "ollama", configure your local host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# For "claude" (e.g. claude-sonnet-4-6) or "ollama" (e.g. llama3.1)
MODEL=claude-sonnet-4-6

# Optional: backend port (the frontend dev proxy expects 8787).
PORT=8787

# Optional account welcome email delivery (from the designated Admin mailbox).
# Company IT must approve the SMTP sender and authentication/relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=praveen.ambrose@motherson.com
SMTP_PASSWORD=
SMTP_RELAY=false
# A URL recipients can reach; do not use localhost.
APP_LOGIN_URL=
# Optional persistent encryption key: base64 encoded 32-byte key for saved SMTP credentials.
# Without it, a local key is generated under scratch/secrets/smtp.key.
MAIL_ENCRYPTION_KEY=
