{
  "name": "sift-resume-agent",
  "version": "1.0.0",
  "private": true,
  "description": "SIFT — AI-powered resume shortlisting and recommendation agent (React + Express + Claude API)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "json5": "^2.2.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "localtunnel": "^2.0.2",
    "vite": "^5.4.11"
  }
}
